# API base URL.
# Leave empty when frontend and backend are served from one HTTPS origin
# and the Nginx /api/ proxy is used.
VITE_API_BASE_URL=

# false = real Spring Boot backend
# true  = local mock mode without backend
VITE_USE_MOCK=false

# Additional UUIDs for dictionary values that are not fixed in src/api/ids.js.

# Family relations
# VITE_FAMILY_RELATION_SELF_ID=
# VITE_FAMILY_RELATION_MOTHER_ID=
# VITE_FAMILY_RELATION_FATHER_ID=
# VITE_FAMILY_RELATION_CHILD_ID=

# Education levels
# VITE_EDUCATION_LEVEL_PRESCHOOL_ID=
# VITE_EDUCATION_LEVEL_COLLEGE_ID=
# VITE_EDUCATION_LEVEL_UNIVERSITY_ID=

# Income categories
# VITE_INCOME_LOW_ID=
# VITE_INCOME_MIDDLE_ID=
# VITE_INCOME_HIGH_ID=

# Employment statuses
# VITE_EMPLOYMENT_EMPLOYED_ID=
# VITE_EMPLOYMENT_UNEMPLOYED_ID=
# VITE_EMPLOYMENT_SELF_ID=
# VITE_EMPLOYMENT_STUDENT_ID=
# VITE_EMPLOYMENT_PENSIONER_ID=
