# Backend (Java) — имена переменных совпадают с application.properties
# и docker-compose.yml (DB_URL/DB_USERNAME/DB_PASSWORD). Раньше здесь были
# указаны SPRING_DATASOURCE_*, которые backend не читает вообще — при
# заполнении .env по этому образцу Spring Boot получал пустой пароль и
# не мог подключиться к БД.
DB_URL=jdbc:postgresql://db:5432/zabota
DB_USERNAME=zabota_user
DB_PASSWORD=changeme

# MAX Bot API
MAX_BOT_TOKEN=your_max_bot_token_here
MAX_BOT_MODE=longpolling
MAX_BOT_USERNAME=your_bot_user_name

# Frontend (используется только при раздельном деплое фронта; для
# локального docker-compose не требуется — nginx проксирует /api/ сам)
VITE_BACKEND_URL=http://localhost:8080
